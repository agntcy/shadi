{
  "_preset": "shadi/copilot-cli-v1",
  "_description": "Safe-launch preset for GitHub Copilot CLI (Homebrew native binary). Use with: shadi --policy policies/presets/copilot-cli.json -- copilot",
  "allow": ["."],
  "read": [
    "/usr/local",
    "/usr/bin",
    "/usr/lib",
    "/bin",
    "/Library",
    "/opt/homebrew",
    "/private/etc/ssl",
    "/private/etc/resolv.conf"
  ],
  "net_block": false,
  "net_allow": [
    "api.github.com",
    "copilot-proxy.githubusercontent.com",
    "github.com",
    "*.github.com",
    "*.githubusercontent.com"
  ],
  "block_command": [
    "curl",
    "wget",
    "nc",
    "netcat"
  ],
  "env_remove": [
    "HTTPS_PROXY",
    "HTTP_PROXY",
    "https_proxy",
    "http_proxy"
  ]
}
