{
  "_preset": "shadi/gemini-v1",
  "_description": "Safe-launch preset for Google Gemini CLI. Use with: shadictl --policy policies/presets/gemini.json --read ~/.nvm --allow ~/.gemini -- gemini",
  "allow": ["."],
  "read": [
    "/usr/local",
    "/usr/bin",
    "/usr/lib",
    "/bin",
    "/Library",
    "/opt/homebrew",
    "/private/etc/ssl",
    "/private/etc/resolv.conf"
  ],
  "net_block": false,
  "net_allow": [
    "generativelanguage.googleapis.com",
    "oauth2.googleapis.com",
    "www.googleapis.com",
    "accounts.google.com",
    "github.com",
    "*.github.com",
    "*.githubusercontent.com"
  ],
  "block_command": [
    "curl",
    "wget",
    "nc",
    "netcat"
  ]
}
