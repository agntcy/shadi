{
  "id": "opencode-isolated",
  "bin": "opencode",
  "pass_env": [
    "ANTHROPIC_API_KEY", "OPENAI_API_KEY", "GOOGLE_GENERATIVE_AI_API_KEY",
    "OPENROUTER_API_KEY", "GROQ_API_KEY"
  ],
  "pin_tmpdir": true,
  "env": {
    "TMPDIR": "{tmpdir}",
    "TMP": "{tmpdir}",
    "TEMP": "{tmpdir}"
  },
  "current_dir_workdir": true,
  "extra_args_env": "OPENCODE_ARGS",
  "isolation": {
    "env": {
      "HOME": "{config_root}",
      "USERPROFILE": "{config_root}",
      "APPDATA": "{config_root}/AppData/Roaming",
      "LOCALAPPDATA": "{config_root}/AppData/Local",
      "XDG_CONFIG_HOME": "{config_root}/.config",
      "XDG_DATA_HOME": "{config_root}/.local/share",
      "XDG_STATE_HOME": "{config_root}/.local/state",
      "XDG_CACHE_HOME": "{config_root}/.cache"
    }
  },
  "provision": { "skills": { "dir": "{config_root}/.config/opencode/skills" } },
  "execute": {
    "args": [
      "run",
      "--auto",
      "{extra_args}",
      "{prompt}"
    ]
  },
  "result": { "kind": "stdout" }
}
