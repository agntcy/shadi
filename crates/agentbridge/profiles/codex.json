{
  "id": "codex",
  "bin": "codex",
  "pin_tmpdir": true,
  "env": {
    "TMPDIR": "{tmpdir}",
    "TMP": "{tmpdir}",
    "TEMP": "{tmpdir}"
  },
  "current_dir_workdir": true,
  "stdin_null": true,
  "extra_args_env": "CODEX_ARGS",
  "provision": { "skills": { "dir": "{workdir}/.agents/skills" } },
  "execute": {
    "args": [
      "exec",
      "{session}",
      "{prompt}",
      "--dangerously-bypass-approvals-and-sandbox",
      "--skip-git-repo-check",
      "{extra_args}"
    ]
  },
  "session": {
    "stderr_prefix": "session id: ",
    "args": ["resume", "{session_id}"],
    "retry_stderr_contains": "no rollout found"
  },
  "result": { "kind": "strip_after_first_line", "line": "--------" }
}
