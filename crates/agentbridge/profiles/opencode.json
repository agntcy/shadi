{
  "id": "opencode",
  "bin": "opencode",
  "pin_tmpdir": true,
  "env": {
    "TMPDIR": "{tmpdir}",
    "TMP": "{tmpdir}",
    "TEMP": "{tmpdir}"
  },
  "current_dir_workdir": true,
  "extra_args_env": "OPENCODE_ARGS",
  "provision": { "skills": { "dir": "{workdir}/.opencode/skills" } },
  "execute": {
    "args": [
      "run",
      "--auto",
      "{extra_args}",
      "{prompt}"
    ]
  },
  "result": { "kind": "stdout" }
}
