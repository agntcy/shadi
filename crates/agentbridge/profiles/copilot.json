{
  "id": "copilot",
  "bin": "copilot",
  "pin_tmpdir": true,
  "env": {
    "TMPDIR": "{workdir}",
    "TMP": "{workdir}",
    "TEMP": "{workdir}"
  },
  "workdir_flags": ["-C", "{workdir}", "--add-dir", "{workdir}"],
  "workdir_flags_on_execute": true,
  "workdir_flags_on_snapshot": true,
  "workdir_flags_on_inject": true,
  "current_dir_workdir": true,
  "system_flag": "--system-prompt",
  "execute": {
    "args": [
      "--prompt",
      "{prompt}",
      "--allow-all-tools",
      "{workdir_flags}",
      "{system}"
    ]
  },
  "result": { "kind": "strip_suffix", "prefix": "Changes" }
}
